{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "displayName": "Linux release (Ninja)",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "displayName": "Linux debug (Ninja, sanitizers off)",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-asan",
            "inherits": "base",
            "displayName": "Linux ASan + UBSan (Ninja)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g"
            }
        },
        {
            "name": "windows-release",
            "inherits": "base",
            "displayName": "Windows x64 release (Ninja)",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "linux-release", "configurePreset": "linux-release" },
        { "name": "linux-debug", "configurePreset": "linux-debug" },
        { "name": "linux-asan", "configurePreset": "linux-asan" },
        { "name": "windows-release", "configurePreset": "windows-release" }
    ],
    "testPresets": [
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-asan",
            "configurePreset": "linux-asan",
            "output": { "outputOnFailure": true },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
                "UBSAN_OPTIONS": "print_stacktrace=1"
            }
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "output": { "outputOnFailure": true }
        }
    ]
}
