# Clang-tidy baseline for IUT-Food - a modest, high-signal set.
#
# Run against the compile database generated by a CMake configure
# (CMAKE_EXPORT_COMPILE_COMMANDS is on by default now):
#
#   cmake --preset linux-release
#   clang-tidy -p build/linux-release src/common/*.cpp src/client/*.cpp src/server/*.cpp
#
# Checks are advisory (WarningsAsErrors is empty): CI stays green while
# contributors get actionable nits from the linter.
Checks: >
  bugprone-argument-comment,
  bugprone-assert-side-effect,
  bugprone-narrowing-conversions,
  bugprone-string-constructor,
  bugprone-suspicious-string-compare,
  bugprone-undefined-memory-manipulation,
  bugprone-unused-return-value,
  misc-unused-parameters,
  misc-unused-using-decls,
  modernize-loop-convert,
  modernize-use-nullptr,
  modernize-use-override,
  performance-for-range-copy,
  performance-unnecessary-copy-initialization,
  readability-redundant-member-init,
WarningsAsErrors: ''
FormatStyle: file
HeaderFilterRegex: 'src/.*\.h$'
CheckOptions:
  - key: readability-redundant-member-init.IgnoreMacros
    value: 'true'
